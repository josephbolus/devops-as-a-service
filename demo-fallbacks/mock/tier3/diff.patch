--- a/tests/test_cli_json.py
+++ b/tests/test_cli_json.py
@@ -0,0 +1,26 @@
+import io
+import json
+import unittest
+from contextlib import redirect_stdout
+
+from app.cli import main
+from app.report import REPORT
+
+
+class CliJson(unittest.TestCase):
+    def test_json_flag_emits_report_as_json(self):
+        buf = io.StringIO()
+        with redirect_stdout(buf):
+            self.assertEqual(main(['--json']), 0)
+        self.assertEqual(json.loads(buf.getvalue()), REPORT)
+
+    def test_default_output_stays_human(self):
+        buf = io.StringIO()
+        with redirect_stdout(buf):
+            self.assertEqual(main([]), 0)
+        self.assertIn('demo-api', buf.getvalue())
+        self.assertFalse(buf.getvalue().lstrip().startswith('{'))
+
+
+if __name__ == '__main__':
+    unittest.main()
